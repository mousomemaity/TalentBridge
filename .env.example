# ==============================================================================
# TalentBridge Environment Variables (Template)
# DO NOT COMMIT ACTUAL PASSWORDS OR SECRETS TO SOURCE CONTROL
# ==============================================================================

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=development

# Application Port
PORT=4000

# MongoDB Connection String (Mandatory)
# Local MongoDB example:
MONGODB_URI=mongodb://localhost:27017/talentbridge

# MongoDB Atlas example (replace placeholders with cluster credentials):
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>.mongodb.net/talentbridge?retryWrites=true&w=majority

# JWT Authentication Secrets (Backend Teammate)
JWT_SECRET=replace_with_a_secure_random_secret_min_32_characters
JWT_EXPIRES_IN=7d

# File Storage Service (AWS S3 / GCP Cloud Storage / Local)
STORAGE_BUCKET_NAME=talentbridge-private-resumes
STORAGE_REGION=us-west-2
STORAGE_ACCESS_KEY_ID=placeholder_key_id
STORAGE_SECRET_ACCESS_KEY=placeholder_secret_key

# AI Matching Service Configuration (AI Teammate)
AI_MODEL_VERSION=talentbridge-ai-v1.2
AI_MATCHING_SERVICE_URL=http://localhost:5000/api/v1/match
