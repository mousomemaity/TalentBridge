# ==============================================================================
# TalentBridge Backend Configuration (.env.example)
# Copy this file to .env and configure values before starting the API server.
# ==============================================================================

# Application Server
PORT=3001
NODE_ENV=development

# Database (MongoDB with Mongoose)
MONGODB_URI=mongodb://127.0.0.1:27017/talentbridge

# JWT Authentication & Refresh Token Rotation
JWT_ACCESS_SECRET=replace-with-a-secure-random-access-secret-key
JWT_REFRESH_SECRET=replace-with-a-secure-random-refresh-secret-key
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# AI Integration Adapter
# Leave empty to safely return status="unavailable" rather than simulated output.
AI_PROVIDER_KEY=
OPENAI_API_KEY=

# File Storage (S3 / CloudFront / MinIO)
STORAGE_BUCKET=talentbridge-storage
STORAGE_REGION=us-east-1
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# CORS & Client Origins
CORS_ORIGINS=http://localhost:3000,http://localhost:8081,exp://localhost:8081
